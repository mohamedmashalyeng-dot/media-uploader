PORT=
NODE_ENV=production
DATABASE_URL=
SESSION_SECRET=

ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

STORAGE_DRIVER=local
LOCAL_MEDIA_DIR=uploads
LOCAL_MEDIA_PUBLIC_BASE_URL=/media

S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_PUBLIC_BASE_URL=https://media.kentbusinesscollege.com
S3_FORCE_PATH_STYLE=false

# Shared hosting friendly defaults.
# Images/videos under this size may pass through Node in local mode.
# Larger files should use S3-compatible direct browser-to-storage upload.
MEDIA_BACKEND_UPLOAD_MAX_MB=100
MEDIA_MAX_IMAGE_MB=15
MEDIA_MAX_VIDEO_MB=100
MEDIA_MAX_DOCUMENT_MB=50

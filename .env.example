PORT=3000
DATABASE_URL=
SESSION_SECRET=

ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# Local development default. Use STORAGE_DRIVER=b2 in production.
STORAGE_DRIVER=local
LOCAL_MEDIA_DIR=uploads
LOCAL_MEDIA_PUBLIC_BASE_URL=/media

# Recommended production storage for lots of files: Backblaze B2.
# Set STORAGE_DRIVER=b2 and fill these values on Hostinger/production.
B2_REGION=us-west-004
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
B2_PUBLIC_BASE_URL=https://media.kentbusinesscollege.com

S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_PUBLIC_BASE_URL=https://media.kentbusinesscollege.com
S3_FORCE_PATH_STYLE=false

MEDIA_MAX_IMAGE_MB=15
MEDIA_MAX_VIDEO_MB=5000
MEDIA_MAX_DOCUMENT_MB=50
MEDIA_BACKEND_UPLOAD_MAX_MB=20
